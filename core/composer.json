{
    "name": "dylaris/gateway-panel-core",
    "description": "Shared core of the DYLARIS Managed Gateway panel plugins",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": { "Dylaris\\GatewayPanel\\": "src/" },
        "files": ["src/Provider/Dto.php"]
    },
    "autoload-dev": {
        "psr-4": { "Dylaris\\GatewayPanel\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true, "platform": { "php": "8.3.0" } }
}
