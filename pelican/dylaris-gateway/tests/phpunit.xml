<?xml version="1.0" encoding="UTF-8"?>
<!-- Run from a Pelican v1.0.0-rc.3 checkout with this plugin in plugins/dylaris-gateway (tools/test-pelican.sh). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="false"
>
    <testsuites>
        <testsuite name="dylaris-gateway">
            <directory>.</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- A throwaway key for the test run only; Crypt needs one. -->
        <env name="APP_KEY" value="base64:AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_URL" value="http://localhost/" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="testing.sqlite"/>
        <env name="GUZZLE_CONNECT_TIMEOUT" value="1"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
